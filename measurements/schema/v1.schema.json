{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KingHacker9000/totem-hardware/measurements/schema/v1.schema.json",
  "title": "Totem prototype measurement dataset v1",
  "type": "object",
  "required": ["schema_version", "dataset_status", "prototype", "units", "datum_convention", "components", "fit_coupons"],
  "properties": {
    "schema_version": {"const": "totem.measurements/v1"},
    "dataset_status": {"enum": ["template", "synthetic", "measured"]},
    "non_production": {"type": "boolean"},
    "prototype": {"const": "prototype-v1"},
    "units": {"const": "mm"},
    "captured_at": {"type": ["string", "null"]},
    "captured_by": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "datum_convention": {
      "type": "object",
      "required": ["origin", "axes", "orientation_rule"],
      "properties": {
        "origin": {"type": "string"},
        "axes": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": {"type": "string"},
            "y": {"type": "string"},
            "z": {"type": "string"}
          },
          "additionalProperties": false
        },
        "orientation_rule": {"type": "string"}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "fit_coupons": {
      "type": "array",
      "items": {"$ref": "#/$defs/coupon"}
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "required": ["name", "value_mm", "source", "cad_driving"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value_mm": {"type": ["number", "null"]},
        "source": {"enum": ["unmeasured", "measured", "reference", "derived"]},
        "cad_driving": {"type": "boolean"},
        "method": {"type": ["string", "null"]},
        "tool": {"type": ["string", "null"]},
        "uncertainty_mm": {"type": ["number", "null"], "minimum": 0},
        "reference": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "measured"}}},
          "then": {"required": ["method"]}
        }
      ],
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": ["name", "kind", "measurements"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["mount_hole", "connector", "cable_exit", "active_area", "acoustic_center", "keepout", "panel_cutout", "service_envelope", "fastener", "other"]},
        "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "selected_part", "orientation", "measurements", "features"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "selected_part": {"type": "string"},
        "serial_or_lot": {"type": ["string", "null"]},
        "orientation": {"type": "string"},
        "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
        "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
        "photos": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "coupon": {
      "type": "object",
      "required": ["id", "purpose", "nominal_mm", "measured_mm", "result"],
      "properties": {
        "id": {"type": "string"},
        "purpose": {"type": "string"},
        "nominal_mm": {"type": "number"},
        "measured_mm": {"type": ["number", "null"]},
        "result": {"enum": ["not_tested", "loose", "acceptable", "tight", "failed"]},
        "printer_profile": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
